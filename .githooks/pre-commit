#!/bin/sh
# Гейт против случайного попадания бинарников и тяжёлых артефактов в репозиторий.
#
# Зачем: `.gitignore` ловит выхлоп по расширению/каталогу (target/, *.class, bin/),
# но `go build` без -o кладёт исполняемый файл С ИМЕНЕМ КАТАЛОГА и БЕЗ расширения —
# такое обобщённым паттерном не отловить. Реальный случай: 18-МБ ELF
# `databases/transactions/brokers/go/tx-brokers` пролежал в git в обоих репозиториях,
# включая публичный. Этот хук проверяет СОДЕРЖИМОЕ, а не имя.
#
# Включить (один раз на клон):
#   git config core.hooksPath .githooks
#
# Обойти осознанно (если правда нужен бинарник — например, тестовая фикстура):
#   git commit --no-verify

fail=0
max_bytes=1048576   # 1 МиБ

# --diff-filter=d — всё, что останется в дереве после коммита, КРОМЕ удалённого.
# Не 'AM': git классифицирует перемещённый файл как R (rename), и фильтр AM его
# пропускал — проверено, ELF под видом переименования проходил насквозь.
for f in $(git diff --cached --name-only --diff-filter=d); do
    [ -f "$f" ] || continue

    # 1. Исполняемые форматы — по магическим байтам, не по имени
    magic=$(head -c 4 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        7f454c46)  echo "БЛОК: $f — ELF-бинарник"        >&2; fail=1; continue;;  # \x7fELF
        4d5a*)     echo "БЛОК: $f — PE/EXE-бинарник"     >&2; fail=1; continue;;  # MZ
        feedface|feedfacf|cafebabe)
                   echo "БЛОК: $f — Mach-O/JVM-бинарник" >&2; fail=1; continue;;
    esac

    # 2. Тяжёлые файлы — почти всегда артефакт сборки или забытый дамп
    size=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$max_bytes" ]; then
        echo "БЛОК: $f — $(($size / 1024)) КиБ, больше 1 МиБ" >&2
        echo "      если это осознанно (фикстура/датасет) — git commit --no-verify" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "Коммит остановлен: в индексе бинарники или тяжёлые артефакты." >&2
    echo "Go-стенды собирать через 'go build -o' в игнорируемый каталог," >&2
    echo "либо дописать путь в .gitignore." >&2
    exit 1
fi
exit 0
