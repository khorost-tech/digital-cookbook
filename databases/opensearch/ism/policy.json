{
  "policy": {
    "policy_id": "app-logs-policy",
    "description": "Демо: жизненный цикл лог-индекса hot -> warm -> snapshot -> delete. Пороги УСКОРЕНЫ (минуты) для наблюдаемости; в проде — дни/десятки ГБ.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [ { "rollover": { "min_doc_count": 5 } } ],
        "transitions": [ { "state_name": "warm", "conditions": { "min_index_age": "1m" } } ]
      },
      {
        "name": "warm",
        "actions": [ { "allocation": { "require": { "box_type": "warm" } } } ],
        "transitions": [ { "state_name": "snapshot", "conditions": { "min_index_age": "2m" } } ]
      },
      {
        "name": "snapshot",
        "actions": [ { "snapshot": { "repository": "ism-snapshots", "snapshot": "app-logs" } } ],
        "transitions": [ { "state_name": "delete", "conditions": { "min_index_age": "3m" } } ]
      },
      {
        "name": "delete",
        "actions": [ { "delete": {} } ],
        "transitions": []
      }
    ],
    "ism_template": [ { "index_patterns": ["app-logs-*"], "priority": 1 } ]
  }
}
