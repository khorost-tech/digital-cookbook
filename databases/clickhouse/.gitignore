# Java / Maven
target/
*.jar
*.class
dependency-reduced-pom.xml

# Go — скомпилированные бинарники стендов (go build без -o кладёт исполняемый
# файл с именем каталога main-пакета; в git должен быть только исходник).
bin/
/dataset/gen
/dataset/dataset
/decision/decision
/distributed/distributed
/drivers/go/drivers
/go/smoke/smoke
/go/mergetree/mergetree
/materialized-views/materialized-views
/ops-stand/ops-stand
/s3/s3
/when-olap/when-olap

# сгенерированный датасет (детерминированный — воспроизводится dataset/main.go,
# не коммитится: десятки млн строк CSV)
*.csv
*.tsv
dataset/out/

# данные томов ClickHouse/PostgreSQL (если когда-либо монтируются локально,
# не в именованный docker volume)
compose/data/
compose/*.log

# build-кэши docker-контейнеров (golang:1.25 /go/pkg/mod, maven:...-eclipse-
# temurin /root/.m2, монтируются как volume в ops/*-demo.sh — не коммитятся)
.gocache/
.m2cache/

# промежуточный вывод live-прогонов (логи стендов) — не коммитится
scratchout/

# окружение
.env
