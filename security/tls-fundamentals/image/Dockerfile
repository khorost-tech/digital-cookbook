# Образ с OpenSSL для стенда.
#
# ПОЧЕМУ ОБРАЗ, А НЕ OPENSSL С МАШИНЫ.
# На машине автора нашлось ДВА разных OpenSSL — 3.5.5 и 3.0.13, — и какой
# из них сработает, решал порядок каталогов в PATH. Один и тот же прогон
# давал разные результаты: под одним openssl проба видела сведения о
# сессии, под другим нет. Фикстура молча зависела бы от того, из какой
# оболочки её сняли.
#
# Тот же урок уже был получен на curl, где системный движок TLS отвергал
# целую цепочку. Правило общее: клиент, чьё поведение зависит от того, чем
# его собрали, берётся из образа.
#
# Этим же образом выпускаются сертификаты: ключ -not_before появился в
# 3.2, и на распространённом 3.0 выпуск просто не пройдёт.
FROM alpine:3.22
RUN apk add --no-cache openssl
ENTRYPOINT ["openssl"]
