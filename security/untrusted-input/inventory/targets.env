# Цели сканирования: три способа поставки FFmpeg, отличающиеся видимостью
# для сканеров. Формат: метка|образ|как поставлен FFmpeg
#
# distro   — контрольная точка: пакет дистрибутива, обязан находиться;
# vendored — тот же бинарник мимо пакетного менеджера (модель jellyfin-ffmpeg);
# jellyfin — настоящая вендорская сборка. Версия 10.11.9 выбрана намеренно:
#            именно на ней JFrog продемонстрировал RCE через CVE-2026-8461.

# Первые три цели — показательные случаи «как бывает в жизни»: у них различаются
# и версии, и дистрибутивы, поэтому влияние ИМЕНИ пакета на них не изолировать.
#
# Последние две — контролируемый эксперимент: ОДИН И ТОТ ЖЕ бинарник, один базовый
# образ, одна версия; отличается только имя пакета в базе dpkg. Сравнивать выводы
# об идентификаторе нужно именно по этой паре.
TARGETS=(
  "distro|ui-inv-distro-package:local|пакет дистрибутива (apt)"
  "vendored|ui-inv-vendored-binary:local|бинарник мимо пакетного менеджера"
  # digest прогона: sha256:bc9fa8e1462fffe3d8d4255fc62af478602641f4c0e5f4875fea8563d1189837
  "jellyfin|jellyfin/jellyfin:10.11.9|вендорская сборка jellyfin-ffmpeg"
  "deb-canonical|ui-inv-deb-canonical:local|КОНТРОЛЬ: тот же бинарник, deb с именем ffmpeg"
  "deb-renamed|ui-inv-deb-renamed:local|КОНТРОЛЬ: тот же бинарник, deb с именем acmecorp-ffmpeg7"
)
