<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3 resource server — зеркало Go-сервиса (backend/go).
         Тот же контракт эндпоинтов (/public, /me, /admin), порт :8082. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>tech.khorost</groupId>
    <artifactId>keycloak-demo</artifactId>
    <version>1.0.0</version>
    <name>keycloak-demo</name>
    <description>Keycloak OIDC resource server (Spring Boot mirror of the Go backend)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Actuator: /actuator/health для healthcheck в docker-compose. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Surefire: тесты используют Mockito (@MockitoBean → мок JwtDecoder).
                 На JDK 21+ Mockito/ByteBuddy динамически подгружает java-агент в свой же
                 JVM (self-attach) для inline-mock-maker; без явного разрешения это даёт
                 предупреждение и в будущих JDK станет ошибкой. -XX:+EnableDynamicAgentLoading
                 разрешает self-attach детерминированно, -Xshare:off снимает CDS-warning.
                 Версия плагина/Mockito — из spring-boot-starter-parent (BOM). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
