{
  "index_patterns": ["logs-tuned*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "timestamp": { "type": "date" },
        "service":   { "type": "keyword" },
        "level":     { "type": "keyword" },
        "message":   { "type": "keyword" },
        "request_id": { "type": "keyword", "index": false, "doc_values": false }
      }
    }
  }
}
