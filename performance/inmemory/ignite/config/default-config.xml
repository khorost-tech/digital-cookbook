<?xml version="1.0" encoding="UTF-8"?>

<!--
  Дефолтный discovery Apache Ignite — мультикаст (TcpDiscoveryMulticastIpFinder).
  В сети docker compose (bridge/overlay) мультикаст-пакеты как правило не
  проходят между контейнерами — узлы не находят друг друга, и топология
  остаётся server=1 на каждом (два независимых singleton-кластера вместо
  одного из двух узлов). Живой прогон этого стенда подтвердил именно это:
  без данного конфига `docker logs ignite-1` печатал `servers=1` бесконечно.

  Фикс — статический TcpDiscoveryVmIpFinder со списком адресов обоих узлов
  по именам docker-сервисов (inmemory-net резолвит их через встроенный DNS
  compose). Порт 47500 — дефолтный диапазон TcpDiscoverySpi (47500..47509).
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="grid.cfg" class="org.apache.ignite.configuration.IgniteConfiguration">
        <!-- ОТКЛОНЕНИЕ ОТ ПЕРВОНАЧАЛЬНОГО ПЛАНА (живой прогон, не выдумано):
             сначала пробовали peerClassLoadingEnabled=true (P2P-деплой байткода
             TopByCategoryTask/CategoryFilter при первом submit). Обнаружено
             живьём: ScanQuery-предикат (CategoryFilter, наивный вариант
             сценария compute) НЕ подхватывается P2P-деплоем — сервер падает с
             BinaryInvalidTypeException/ClassNotFoundException при десериализации
             запроса, хотя IgniteCompute.affinityCall с тем же флагом на обеих
             сторонах в целом совместим (см. task-6-report.md). Вместо отладки
             границ P2P-деплоя — стандартный для прод-эксплуатации Ignite путь:
             классы стенда деплоятся на classpath серверных нод заранее (см.
             volumes в compose/ignite.yml — тонкий jar без ignite-core
             монтируется в $IGNITE_HOME/libs/, подхватывается автосканом при
             старте JVM). Peer class loading здесь не нужен и оставлен
             выключенным (дефолт). -->
        <property name="discoverySpi">
            <bean class="org.apache.ignite.spi.discovery.tcp.TcpDiscoverySpi">
                <property name="ipFinder">
                    <bean class="org.apache.ignite.spi.discovery.tcp.ipfinder.vm.TcpDiscoveryVmIpFinder">
                        <property name="addresses">
                            <list>
                                <value>ignite-1:47500..47509</value>
                                <value>ignite-2:47500..47509</value>
                            </list>
                        </property>
                    </bean>
                </property>
            </bean>
        </property>
    </bean>
</beans>
