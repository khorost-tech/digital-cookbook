# Go-бинарники (не ловятся общим паттерном без расширения на Linux/macOS)
/dataset/dataset
/dataset/main
/codecs/codecs
/codecs/codecs-linux
/codecs/main
/analysis/analysis
/analysis/main
/httpdemo/httpdemo
/httpdemo/main
*.exe

# сгенерированные профили корпуса (воспроизводимы генератором, seed=42)
/profiles/

# данные томов, если монтируются локально
compose/data/
compose/*.log

# ВНИМАНИЕ: evidence/*.log НЕ игнорируются намеренно. Логи живых прогонов
# обязаны отслеживаться git — на них ссылаются FIXTURES и README, и без них
# эти ссылки читателю непроверяемы. Общее правило *.log в корневом
# .gitignore их бы съело, поэтому там стоит явное исключение.
# Проверять состав нужно через `git ls-files evidence/`, а не через `ls`.

# рабочие каталоги прогонов матрицы (сырой вывод codecs -out и логи драйвера).
# Публикуемый результат сводится из них в evidence/, сами прогоны не
# коммитятся: это несколько мегабайт машинно-специфичных таймингов, которые
# нечем проверить в чужом окружении.
scratchout*/

# окружение
.env
