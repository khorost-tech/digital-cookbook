# Вариант сервиса со слоем HTTP crow.
#
# Crow: заголовочный слой поверх asio. Рабочая единица — поток из пула (concurrency); дефолт — число аппаратных потоков машины.
#
# ЭТОТ ФАЙЛ ПОСТРОЧНО СИММЕТРИЧЕН ДВУМ ОСТАЛЬНЫМ: те же шаги, тот же
# порядок, различается ровно имя слоя. Симметрия не на честном слове —
# её держит проверка (scripts/test_variants.py), сравнивающая три файла
# инструкция за инструкцией после замены имени слоя меткой.
#
# Ни имени варианта, ни числа рабочих единиц здесь нет и быть не может:
# образ общий, и запечённое в него значение склеило бы два варианта в
# одну строку фикстуры — причём прогон при этом выглядел бы успешным.
# Обе величины приходят при ЗАПУСКЕ (scripts/docker.py, run_variant).
FROM cpp-service-and-postgres-base:latest
RUN /usr/local/bin/install-layer.sh crow
COPY service /src
RUN /usr/local/bin/build-service.sh crow
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/stand_service"]
