# Сосед по языку: тот же сервис на Go, упакован так же, как плечо
# musl-static оси упаковки, — статический бинарник в scratch.
#
# ЭТОТ ЖЕ ФАЙЛ ОБСЛУЖИВАЕТ ТРИ ПЛЕЧА: измеряемое "go" и два
# отрицательных контроля. Ручек у сервиса две, и живой контроль нужен
# КАЖДОЙ:
#
#   * "go-divergent" отличается от "go" РОВНО значением HEALTHZ_BODY
#     (линковщик кладёт его в main.healthzBody) и обязан разойтись по
#     ответу /healthz;
#   * "go-resolve-divergent" отличается РОВНО значением RESOLVE_PROBE
#     (main.probeName) и обязан разойтись по сравниваемому телу
#     /resolve — при совпадающем ответе /healthz.
#
# Контроль, роняющий только первую ветку, оставляет вторую уронённой
# лишь мутацией копии фикстуры, то есть без живого замера. Значения по
# умолчанию совпадают с тем, что печатают плечи C++ и Rust, поэтому
# измеряемое плечо остаётся побайтно тождественным им.
# Правя этот файл, помни, что правка задевает все три плеча разом.
#
# ПОЧЕМУ GOPROXY=off. Это не украшение и не осторожность, а САМО
# ИЗМЕРЕНИЕ условия «ни одной зависимости сверх стандартной библиотеки».
# Пустой go.mod написал автор стенда, и как доказательство он не годится;
# сборка при выключенном реестре модулей — годится: любая внешняя
# зависимость уронила бы её.
#
# ПОЧЕМУ GOTOOLCHAIN=local. Иначе директива go в go.mod, оказавшаяся выше
# установленной версии, заставила бы Go скачивать тулчейн — то есть
# сборка полезла бы в сеть, и GOPROXY=off перестал бы что-либо
# доказывать.
# ЗАКРЕПЛЕНИЕ БАЗОВОГО ОБРАЗА ПО ДАЙДЖЕСТУ. Тег — подвижный указатель:
# под тем же именем завтра лежит другое содержимое, и прогон,
# сравниваемый с этими фикстурами, сравнивал бы их с другим образом молча.
# Дайджест снят с ИНДЕКСА (манифест-листа), а не с образа под конкретную
# архитектуру: он так же неизменяем, но оставляет разрешение архитектуры
# докеру. Тег рядом с дайджестом оставлен для чтения человеком — Docker
# при наличии дайджеста тег игнорирует.
FROM golang:1.24-alpine@sha256:8bee1901f1e530bfb4a7850aa7a479d17ae3a18beb6e09064ed54cfd245b7191 AS build
ARG STAND_NONCE=none
ARG HEALTHZ_BODY=ok
ARG RESOLVE_PROBE=resolve
# CGO_ENABLED=0 — не только про статическую линковку. Без cgo бинарник
# не умеет звать C вовсе, то есть net.LookupHost заведомо работает
# СОБСТВЕННЫМ резолвером Go, а не getaddrinfo той libc, с которой
# слинкованы соседи. Значение печатается в файл лечения именно как улика
# этого: измеритель читает его из образа, а не из этой строки.
ENV CGO_ENABLED=0 \
    GOPROXY=off \
    GOFLAGS=-mod=mod \
    GOTOOLCHAIN=local
# binutils нужен не сборке, а ЗАМЕРУ: число разделяемых зависимостей
# снимается readelf'ом по записям NEEDED в самом бинарнике. Ответ ldd для
# этого не годится — он текстовый, разный у glibc и musl и у статического
# PIE печатает путь загрузчика, который зависимостью не является.
RUN apk add --no-cache binutils
COPY siblings/go /src
WORKDIR /src
# Метка прогона пишется в образ ПЕРЕД шагом компиляции и читается обратно
# измерителем: слой, переиспользованный из кэша, отдал бы чужую метку.
RUN echo "$STAND_NONCE" > /nonce
RUN mkdir -p /build \
 && go build -trimpath \
      -ldflags "-s -w -X main.healthzBody=$HEALTHZ_BODY -X main.probeName=$RESOLVE_PROBE" \
      -o /build/stand_service . \
 && { echo "LANG=[go]"; \
      echo "TOOLCHAIN=[$(go version)]"; \
      echo "GOPROXY=[$GOPROXY]"; \
      echo "GOFLAGS=[$GOFLAGS]"; \
      echo "CGO_ENABLED=[$CGO_ENABLED]"; \
      echo "GOTOOLCHAIN=[$GOTOOLCHAIN]"; \
      echo "HEALTHZ_BODY=[$HEALTHZ_BODY]"; \
      echo "RESOLVE_PROBE=[$RESOLVE_PROBE]"; \
      echo "STRIP=[ldflags -s -w]"; \
      echo "EXTERNAL_MODULES=[$(go version -m /build/stand_service | grep -c '	dep	' || true)]"; \
    } > /treatment.txt

FROM scratch
COPY --from=build /build/stand_service /stand_service
COPY images/resolv.conf /etc/resolv.conf
ENV STAND_VARIANT=go
ENTRYPOINT ["/stand_service"]
