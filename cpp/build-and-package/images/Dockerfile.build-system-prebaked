# Плечо «системная зависимость, полученная заранее»: тот же пакет
# дистрибутива, но установленный ВНЕ замеряемой сборки — он уже лежит в
# образе cpp-build-and-package-base:sysdeps.
#
# ЗАЧЕМ ЭТО ПЛЕЧО СУЩЕСТВУЕТ ОТДЕЛЬНО. Оно якорит требование R4: задача
# 5 меряет воспроизводимость сборки, а для этого сборка не должна
# ходить в сеть — иначе кэш пакетного менеджера станет второй
# переменной. Здесь сеть при сборке не нужна вовсе, и это проверяется
# контролем system-offline: тот же Dockerfile, отличается РОВНО флаг
# --network=none.
#
# ЧЕМ ОНО ОТЛИЧАЕТСЯ ОТ ПЛЕЧА system. Ровно местом установки
# зависимости. Тот же пакет (libfmt-dev=10.1.1+ds1-4), тот же исходник,
# та же команда cmake, тот же компилятор. Поэтому пару можно читать как
# «сколько стоит получение зависимости»: всё остальное у них совпадает,
# включая размер бинарника побайтно.
#
# ЕГО cold_seconds НЕ СРАВНИВАЕТСЯ С МЕНЕДЖЕРАМИ. Окно замера у него
# другое: зависимость добыта раньше, кем-то другим. Это записано в
# строке фикстуры полем measurement_window, и разбор печатает кратности
# только внутри одного окна.
FROM cpp-build-and-package-base:sysdeps

RUN sh /images/fmt-version.sh /usr/include /fmt_version.txt

RUN dpkg -L libfmt-dev > /tmp/libfmt-files.txt \
 && { grep -c '\.a$' /tmp/libfmt-files.txt || true; } > /fmt_static_archives.txt

# Заявленная версия ПАКЕТА — отдельно от измеренной версии БИБЛИОТЕКИ.
# Это не дубль: пакет дистрибутива объявляет одно, а FMT_VERSION в
# заголовке, который увидит компилятор, может говорить другое. Обе
# величины пишутся в строку фикстуры, и сравнения оси идут по
# ИЗМЕРЕННОЙ.
RUN dpkg-query -W -f='${Version}' libfmt-dev > /fmt_version_declared.txt

ARG SOURCE_STAMP=0
COPY service /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build -j \
 && strip /build/stand_service
