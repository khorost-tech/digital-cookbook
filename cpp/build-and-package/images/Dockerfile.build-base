# Общий образ инструментов для ВСЕЙ оси сборки. Здесь есть компилятор,
# cmake и всё, что нужно менеджерам пакетов, — но НЕТ fmt.
#
# Зачем отдельный образ. Ось меряет, откуда берётся зависимость, а не
# сколько живёт apt-get. Если бы каждое плечо ставило свои инструменты
# внутри замеряемой сборки, в холодное время попадала бы разная работа
# apt: у vcpkg — git и zip, у conan — python3-pip, у системного плеча —
# ничего. Плечи различались бы двумя вещами сразу. Общий образ
# инструментов оставляет ровно одну переменную: способ получить fmt.
#
# Версия cmake закреплена явно. Все три плеча обязаны собирать сервис
# ОДНИМ cmake: разная версия генератора — вторая переменная, ровно та
# же ошибка, на которой уже спотыкалась пара glibc-static/-old в оси
# упаковки (см. images/Dockerfile.glibc-static).
#
# VCPKG_FORCE_SYSTEM_BINARIES=1 — не украшение. Без него vcpkg скачивает
# СВОИ cmake и ninja и собирает fmt ими, а сервис собирался бы системным
# cmake: внутри одного плеча оказалось бы два разных cmake, и версия
# инструмента перестала бы совпадать с остальными плечами.
# ЗАКРЕПЛЕНИЕ БАЗОВОГО ОБРАЗА ПО ДАЙДЖЕСТУ. Тег — подвижный указатель:
# под тем же именем завтра лежит другое содержимое, и прогон,
# сравниваемый с этими фикстурами, сравнивал бы их с другим образом молча.
# Дайджест снят с ИНДЕКСА (манифест-листа), а не с образа под конкретную
# архитектуру: он так же неизменяем, но оставляет разрешение архитектуры
# докеру. Тег рядом с дайджестом оставлен для чтения человеком — Docker
# при наличии дайджеста тег игнорирует.
FROM gcc:15@sha256:fb2568a8cc0609134396aeb1eae1f3a91c8ceec54aaee67c798d9602593abd66

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      cmake=3.31.6-2 \
      ninja-build \
      git curl zip unzip tar pkg-config ca-certificates \
      python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/*

ENV VCPKG_FORCE_SYSTEM_BINARIES=1

# Измеритель версии fmt — общий для всех плеч. Лежит в базовом образе,
# а не копируется в каждое плечо: способ снять версию обязан быть один и
# тот же, иначе «одинаковая версия у vcpkg и conan» окажется совпадением
# двух разных способов чтения, а не измерением.
COPY images/fmt-version.sh /images/fmt-version.sh
