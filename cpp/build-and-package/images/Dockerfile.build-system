# Плечо «системная зависимость»: менеджера пакетов нет вовсе, fmt
# приходит из репозитория дистрибутива.
#
# ПОЧЕМУ apt-get СТОИТ ВНУТРИ ЗАМЕРЯЕМОЙ СБОРКИ. Раньше libfmt-dev лежал
# в базовом образе, то есть ВНЕ замера, а vcpkg и conan получали свою
# зависимость ВНУТРИ. `cold_seconds` у системного плеча означал тогда
# «компиляция сервиса», а у менеджерских — «установка менеджера,
# получение пакета, сборка fmt и компиляция сервиса»: две разные
# величины под одним именем в одной колонке. Кратность «менеджер дороже
# системы во столько-то раз», посчитанная по такой колонке, сравнивала
# несравнимое. Окно замера выровнено плечом, а не оговоркой: здесь
# получение зависимости входит в замер ровно так же, как у менеджеров.
#
# Плечо с прежним поведением никуда не делось — это system-prebaked
# (Dockerfile.build-system-prebaked). Пара system / system-prebaked
# различается РОВНО местом установки зависимости: один и тот же пакет
# той же версии, один и тот же исходник, одна и та же команда cmake.
#
# Версия пакета закреплена явно. Плавающая версия дистрибутива сделала
# бы вторую переменную между этим плечом и его парой.
#
# ARG SOURCE_STAMP стоит непосредственно перед COPY service: смена его
# значения обесценивает кэш ровно у копирования исходника и сборки, но
# НЕ у слоя получения зависимости выше. Так меряется пересборка своего
# кода при уже разрешённых зависимостях.
FROM cpp-build-and-package-base:tools

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      libfmt-dev=10.1.1+ds1-4 \
 && rm -rf /var/lib/apt/lists/*

# Версия снимается ДО компиляции — измерением заголовка, а не чтением
# того, что просили. Заодно пишется в вывод сборки: у плеча, которое
# упало на компиляции, образа не будет, и достать число из него уже
# нечем — а из журнала сборки можно.
RUN sh /images/fmt-version.sh /usr/include /fmt_version.txt

# Сколько статических архивов несёт пакет дистрибутива. Главная находка
# оси объясняется тем, что libfmt-dev несёт только .so; стенд же меряет
# лишь следствие (ldd не показывает libfmt). Если дистрибутив однажды
# положит в пакет .a, объяснение станет неверным, а следствие останется
# прежним — и стенд промолчит. Это число ловит такой день.
RUN dpkg -L libfmt-dev > /tmp/libfmt-files.txt \
 && { grep -c '\.a$' /tmp/libfmt-files.txt || true; } > /fmt_static_archives.txt

# Заявленная версия ПАКЕТА — отдельно от измеренной версии БИБЛИОТЕКИ.
# Это не дубль: пакет дистрибутива объявляет одно, а FMT_VERSION в
# заголовке, который увидит компилятор, может говорить другое. Обе
# величины пишутся в строку фикстуры, и сравнения оси идут по
# ИЗМЕРЕННОЙ.
RUN dpkg-query -W -f='${Version}' libfmt-dev > /fmt_version_declared.txt

ARG SOURCE_STAMP=0
COPY service /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build -j \
 && strip /build/stand_service
