# Ось 3: воспроизводимость сборки. Один и тот же исходник собирается
# дважды, у обеих сборок берётся sha256 бинарника.
#
# ПОЧЕМУ ПОВЕРХ sysdeps, А НЕ ПОВЕРХ ПЛЕЧА МЕНЕДЖЕРА. Решение R4: сборка,
# на которой меряется воспроизводимость, не должна ходить в сеть, иначе
# кэш пакетного менеджера станет второй переменной — два прогона могли бы
# получить разные сборки одной и той же библиотеки, и расхождение сумм
# объяснялось бы сразу двумя причинами. Здесь зависимость (libfmt-dev)
# уже лежит в базовом образе, и все сборки оси идут с --network=none.
#
# ЗАЧЕМ BUILD_NONCE. Кэш слоёв Docker — главный враг этой оси.
# Совпадение сумм, полученное кэшем, значит только то, что второй сборки
# не было вовсе. Метка прогона стоит ПЕРЕД шагом компиляции: разное
# значение делает кэш недоступным для всех последующих слоёв. Она же
# служит уликой — прогон читает её ОБРАТНО из собранного образа
# (docker run ... cat /nonce), и совпадение меток означает, что второй
# образ есть первый образ. Сама метка в бинарник не попадает: она пишется
# в отдельный файл и в команду компиляции не входит.
#
# ЗАЧЕМ РАЗНЫЕ КАТАЛОГИ СБОРКИ. Во-первых, это второй, независимый повод
# кэшу не совпасть: текст команды RUN у двух сборок разный. Во-вторых,
# абсолютный путь каталога сборки — один из классических источников
# расхождения, и именно его закрепляет -ffile-prefix-map. Без разных
# каталогов флаг закрепления нечего было бы закреплять.
#
# ТРИ РУЧКИ ВМЕСТО ОДНОЙ. Первая редакция знала только REPRO_PINNED, и
# все её сборки шли в Release без -g и со strip. В такой бинарник
# абсолютные пути и метки времени не попадают вовсе — то есть
# SOURCE_DATE_EPOCH и -ffile-prefix-map лечили ровно то, чего в нём нет,
# и плечо pinned оказалось плечом без лечения. Поэтому ручек теперь три:
#
#   REPRO_PINNED — закрепление (SOURCE_DATE_EPOCH и -ffile-prefix-map);
#   REPRO_DEBUG  — отладочная информация (-g): она и открывает канал, по
#                  которому путь каталога сборки попадает в объекты;
#   REPRO_STRIP  — выполнять ли strip: именно этот шаг канал закрывает,
#                  и плечо debug-stripped существует, чтобы это показать.
#
# Фактически применённое лечение ПЕЧАТАЕТСЯ САМИМ ШАГОМ сборки в
# /repro_treatment.txt, и прогон читает его оттуда, а не подставляет из
# своей памяти: иначе в фикстуре стояло бы объявление о лечении, а не
# измерение того, что применилось. Печатается всё, чем плечи вообще
# различаются, включая каталог сборки и то, выполнялся ли strip. Строка
# пишется ПОСЛЕ сборки и после шага strip: до них она была бы намерением,
# после — отчётом о сделанном.
FROM cpp-build-and-package-base:sysdeps

RUN sh /images/fmt-version.sh /usr/include /fmt_version.txt

COPY service /src

ARG BUILD_NONCE=0
RUN echo "$BUILD_NONCE" > /nonce

ARG BUILD_DIR=/build
ARG REPRO_PINNED=0
ARG REPRO_DEBUG=0
ARG REPRO_STRIP=1
# Флаг для отрицательного контроля: он обязан МЕНЯТЬ бинарник. Пустой у
# всех измеряемых плеч.
ARG EXTRA_CXX_FLAGS=

RUN set -eu; \
    if [ "$REPRO_PINNED" = "1" ]; then \
        export SOURCE_DATE_EPOCH=1700000000; \
        PIN="-ffile-prefix-map=$BUILD_DIR=/build -ffile-prefix-map=/src=/src"; \
    else \
        PIN=""; \
    fi; \
    if [ "$REPRO_DEBUG" = "1" ]; then DEBUG="-g"; else DEBUG=""; fi; \
    FLAGS="$DEBUG $PIN $EXTRA_CXX_FLAGS"; \
    cmake -S /src -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_FLAGS="$FLAGS"; \
    cmake --build "$BUILD_DIR" -j; \
    if [ "$REPRO_STRIP" = "1" ]; then \
        strip "$BUILD_DIR/stand_service"; STRIPPED=yes; \
    else \
        STRIPPED=no; \
    fi; \
    cp "$BUILD_DIR/stand_service" /stand_service; \
    echo "REPRO_TREATMENT BUILD_DIR=[$BUILD_DIR] FLAGS=[$FLAGS]" \
         "SOURCE_DATE_EPOCH=[${SOURCE_DATE_EPOCH:-<unset>}]" \
         "STRIP=[$STRIPPED]" > /repro_treatment.txt; \
    cat /repro_treatment.txt
