# СПРАВОЧНОЕ ПЛЕЧО, ВНЕ ОСИ: тот же сервис на C++ БЕЗ библиотеки fmt.
#
# ЗАЧЕМ. Решение R2 фиксирует, каким плечом C++ представлен в оси
# (musl-static оси упаковки), и не запрещает справочный замер рядом с
# ней. Бинарник плеча cpp несёт внутри статически слинкованный fmt, у
# соседей на Go и Rust аналога нет; пока это была только оговорка,
# кратность «cpp / rust» стояла в таблице без единого знака рядом.
# Разность байтов между этим плечом и плечом cpp — и есть цена fmt в
# этой сборке.
#
# ЧТО СОВПАДАЕТ С Dockerfile.musl-static ДОСЛОВНО: базовый образ
# (alpine:3.22), компилятор и cmake из тех же пакетов Alpine, флаги
# cmake (Release, STAND_STATIC=ON), шаг strip той же утилитой binutils,
# метка прогона, файл лечения, финальный образ scratch с тем же
# /etc/resolv.conf. Совпадение тулчейна не объявляется, а проверяется:
# поле toolchain у обоих плеч читается из образа и обязано совпасть.
#
# ЧТО РАЗЛИЧАЕТСЯ: сборка fmt из исходника и линковка с ней убраны,
# форматирование идёт через snprintf. Плюс binutils назван в apk явно —
# у musl-static он приезжает зависимостью g++. На получаемый бинарник
# это не влияет никак (пакет живёт только в стадии сборки), а strip и
# readelf перестают зависеть от чужого списка зависимостей.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ КАТАЛОГ ИСХОДНИКА. service/ — общий исходник осей 1 и
# 2, он линкуется с fmt и правке не подлежит: правка меняла бы байты
# плеча musl-static и обесценивала бы уже снятые фикстуры тех осей.
# ЗАКРЕПЛЕНИЕ БАЗОВОГО ОБРАЗА ПО ДАЙДЖЕСТУ. Тег — подвижный указатель:
# под тем же именем завтра лежит другое содержимое, и прогон,
# сравниваемый с этими фикстурами, сравнивал бы их с другим образом молча.
# Дайджест снят с ИНДЕКСА (манифест-листа), а не с образа под конкретную
# архитектуру: он так же неизменяем, но оставляет разрешение архитектуры
# докеру. Тег рядом с дайджестом оставлен для чтения человеком — Docker
# при наличии дайджеста тег игнорирует.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS build
RUN apk add --no-cache cmake g++ make binutils
COPY siblings/cpp-nofmt /src
# Метка прогона пишется в образ ПЕРЕД шагом компиляции и читается обратно
# измерителем: слой, переиспользованный из кэша, отдал бы чужую метку.
ARG STAND_NONCE=none
RUN echo "$STAND_NONCE" > /nonce
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DSTAND_STATIC=ON \
 && cmake --build /build -j \
 && strip /build/stand_service \
 && { echo "LANG=[c++]"; \
      echo "TOOLCHAIN=[$(g++ --version | head -1)]"; \
      echo "CMAKE=[$(cmake --version | head -1)]"; \
      echo "BUILD_TYPE=[Release]"; \
      echo "STAND_STATIC=[ON]"; \
      echo "STRIP=[strip]"; \
      echo "EXTERNAL_LIBS=[нет]"; \
    } > /treatment.txt

FROM scratch
COPY --from=build /build/stand_service /stand_service
COPY images/resolv.conf /etc/resolv.conf
ENV STAND_VARIANT=cpp-nofmt
ENTRYPOINT ["/stand_service"]
