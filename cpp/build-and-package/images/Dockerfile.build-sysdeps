# Образ инструментов ПЛЮС системный fmt. Отличается от build-base ровно
# одним пакетом — libfmt-dev из репозитория дистрибутива.
#
# Кого он обслуживает. Только плечо `system-prebaked` и его контроль
# `system-offline`. Измеряемое плечо `system` этот образ НЕ использует:
# оно ставит libfmt-dev внутри замеряемой сборки, чтобы окно замера
# совпадало с менеджерскими плечами.
#
# Зачем плечо с зависимостью вне замера всё-таки нужно. Задача 5 меряет
# воспроизводимость сборки, и там сборка не должна ходить в сеть, иначе
# кэш пакетного менеджера станет второй переменной. Плечо, собранное
# поверх этого образа, не выполняет ни одного сетевого обращения — и
# это проверяется контролем `system-offline` (тот же Dockerfile,
# собранный с `--network=none`, обязан собраться).
#
# Это не «бесплатная» зависимость: цену за неё заплатил тот, кто собирал
# базовый образ. Именно поэтому cold_seconds плеча `system-prebaked` не
# сравнивается с менеджерскими: у него другое окно замера, и это
# записано в строке фикстуры полем measurement_window.
FROM cpp-build-and-package-base:tools

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      libfmt-dev=10.1.1+ds1-4 \
 && rm -rf /var/lib/apt/lists/*
