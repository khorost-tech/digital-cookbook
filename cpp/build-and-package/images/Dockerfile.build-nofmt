# Контроль с заведомо известным ОТРИЦАТЕЛЬНЫМ результатом.
#
# Тот же базовый образ инструментов, что у плеч vcpkg и conan, тот же
# исходник, тот же cmake — убран ровно один шаг: получение зависимости.
# Конфигурация ОБЯЗАНА упасть на find_package(fmt CONFIG REQUIRED).
#
# Зачем это нужно. Без такого контроля успех плеча vcpkg или conan
# ничего не доказывает: cmake мог найти fmt, случайно оставшийся в
# базовом образе, и обе строки оси рассказывали бы про системную
# зависимость под чужими именами. Падение этого плеча — единственное
# прямое свидетельство, что в базовом образе fmt действительно нет, а
# значит успех менеджерских плеч приписывается именно менеджеру.
#
# Плечо, которое обязано упасть, нельзя проверять по коду возврата
# конвейера с grep: `docker build ... | grep ...` вернул бы код grep, и
# сборка, упавшая не там, где ожидалось, выглядела бы правильным
# отказом. Прогон снимает код возврата отдельно от текста ошибки — см.
# scripts/build.py:_timed_build.
FROM cpp-build-and-package-base:tools

ARG SOURCE_STAMP=0
COPY service /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build -j \
 && strip /build/stand_service
