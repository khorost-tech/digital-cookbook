# Плечо vcpkg. Зависимость приходит из манифеста service/vcpkg.json,
# vcpkg собирает fmt из исходников под текущий тройник.
#
# ПОЧЕМУ БАЗОВАЯ ЛИНИЯ РЕЕСТРА ЗАКРЕПЛЕНА КОММИТОМ (VCPKG_REF).
# Манифест vcpkg.json называет зависимость («fmt»), но не её версию:
# версию выбирает состояние реестра на момент сборки. Реестр рулонный,
# и на его текущем состоянии стенд получил fmt мажорной версии, которой
# никто не просил, после чего тот же исходник сервиса перестал
# компилироваться. Это не поломка стенда, а свойство ДАННОГО манифеста,
# и оно записано отдельным плечом-контролем `vcpkg-latest`: тот же файл,
# тот же аргумент, отличается РОВНО значение VCPKG_REF.
#
# Оговорка, без которой утверждение было бы неверным: закрепить версию
# в манифесте vcpkg УМЕЕТ — через builtin-baseline вместе с "version>="
# и overrides. Стенд меряет не отсутствие такой возможности, а
# поведение манифеста, который её не использует.
#
# Закрепление — commit SHA, а не тег. Тег git подвижен: его можно
# перевесить, и клон по тому же имени принесёт другое дерево — то есть
# тег закрепляет ИМЯ, а не содержимое. Microsoft документирует
# закрепление реестра (builtin-baseline) именно как commit SHA:
# https://learn.microsoft.com/en-gb/vcpkg/users/versioning
# Коммит ce613c41 — это то, на что указывал тег 2025.04.09 (тег лёгкий,
# указывает прямо на коммит), так что дерево получается то же самое.
# Оно несёт ту же версию fmt, что закреплена в conanfile.txt (какую
# именно — говорит фикстура, а не этот комментарий).
# Без этого плечи vcpkg и conan различались бы двумя вещами сразу
# (менеджером И версией библиотеки), и разница в размере бинарника не
# приписывалась бы ни тому, ни другому.
#
# Установка самого менеджера (клон реестра + bootstrap) входит в
# замеряемую сборку намеренно. Симметрично с плечом conan, где в замер
# входит `pip install conan`, и с плечом system, где в замер входит
# `apt-get install libfmt-dev`: у всех трёх измеряемых плеч окно замера
# одно и то же — получение зависимости плюс сборка сервиса.
#
# Манифест копируется ОТДЕЛЬНО от исходника сервиса. Иначе смена
# SOURCE_STAMP обесценивала бы и слой получения fmt, и «пересборка
# своего кода» превращалась бы в полную холодную сборку.
#
# VCPKG_MANIFEST_MODE=OFF при конфигурации сервиса: зависимость уже
# установлена шагом выше, и повторный проход манифеста на этапе cmake
# добавил бы в замер сборки сервиса работу менеджера, которую мы уже
# посчитали.
FROM cpp-build-and-package-base:tools

# Получение реестра через fetch, а не clone --branch: `clone --branch`
# принимает только имя ветки или тега и на сумму коммита не годится.
# Этот же вид команды работает и для плеча-контроля, где VCPKG_REF
# остаётся именем ветки (master), — способ получить реестр обязан быть
# у пары один, иначе плечи различались бы двумя вещами сразу.
ARG VCPKG_REF=ce613c41372b23b1f51333815feb3edd87ef8a8b
RUN mkdir -p /opt/vcpkg \
 && cd /opt/vcpkg \
 && git init -q . \
 && git remote add origin https://github.com/microsoft/vcpkg.git \
 && git fetch -q --depth 1 origin "${VCPKG_REF}" \
 && git checkout -q FETCH_HEAD \
 && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics

COPY service/vcpkg.json /manifest/vcpkg.json
RUN cd /manifest \
 && /opt/vcpkg/vcpkg install --triplet x64-linux

# Версия снимается СРАЗУ после установки порта, ДО компиляции сервиса.
# Плечо-контроль vcpkg-latest падает именно на компиляции: снимай версию
# после неё — у контроля она осталась бы пустой, и утверждение
# «незакреплённый реестр подсовывает fmt такой-то версии» опиралось бы на
# доразведочную пробу, а не на фикстуру. Число печатается ещё и в вывод
# сборки: у упавшего плеча образа не будет, а журнал останется.
RUN sh /images/fmt-version.sh \
      /manifest/vcpkg_installed/x64-linux/include /fmt_version.txt

ARG SOURCE_STAMP=0
COPY service /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
      -DVCPKG_MANIFEST_MODE=OFF \
      -DCMAKE_PREFIX_PATH=/manifest/vcpkg_installed/x64-linux \
 && cmake --build /build -j \
 && strip /build/stand_service
